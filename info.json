{
  "name": "miniloader-redux-fork",
  "version": "1.0.5",
  "title": "Miniloader (Redux) Fork",
  "description": "Factorio 2.1 fork with fixed-axis input/output rotation, belt-aware automatic placement, reliable robot-built rotated blueprints, and recovery of existing loaders. Includes underground-belt crash fixes and normal, speed and lane-filter modes.",
  "author": "hgschmie (original); johnmart19 / FactorioMods (fork)",
  "contact": "https://github.com/FactorioMods/factorio-miniloader-redux-fork/issues/",
  "homepage": "https://github.com/FactorioMods/factorio-miniloader-redux-fork",
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1.23",
    "! miniloader-redux",
    "(?) matts-logistics-updated",
    "(?) Krastorio2 >= 2.0.7",
    "(?) boblogistics >= 2.1.0",
    "(?) advanced-furnaces-2-updated",
    "(?) space-exploration",
    "(?) TurboBelt"
  ],
  "package": {
    "git_publish_branch": "main",
    "readme": "README.md",
    "gallery": [
      "portal/all-belts.gif",
      "portal/all-belts-stacked.gif",
      "portal/lane-filter.gif",
      "portal/sideloading.gif",
      "portal/normal-mode-gui.png",
      "portal/speed-mode-gui.png",
      "portal/extended_rotation.gif",
      "portal/picker-dollies.gif"
    ],
    "sync_portal_details": true,
    "ignore": [
      "**/*.xcf",
      "**/.zip",
      ".DS_Store",
      ".claude/*",
      ".git",
      ".gitattributes",
      ".gitignore",
      ".vscode",
      "claude-issues.md",
      "graphics/**/*.webp",
      "portal/*",
      "releases/*"
    ]
  }
}
